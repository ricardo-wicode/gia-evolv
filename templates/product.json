{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "gia_comparison": {
      "type": "gia-comparison",
      "blocks": {
        "row-1": {
          "type": "row",
          "settings": {
            "criterion": "Dosis por porción",
            "us": "Dosis completa del estudio",
            "them": "Fracción repartida"
          }
        },
        "row-2": {
          "type": "row",
          "settings": {
            "criterion": "Transparencia de etiqueta",
            "us": "Cada miligramo publicado",
            "them": "Mezclas propietarias"
          }
        },
        "row-3": {
          "type": "row",
          "settings": {
            "criterion": "Forma del ingrediente",
            "us": "Alta biodisponibilidad",
            "them": "La más económica"
          }
        },
        "row-4": {
          "type": "row",
          "settings": {
            "criterion": "Certificado por lote",
            "us": "Sí, en cada lote",
            "them": "Rara vez disponible"
          }
        },
        "row-5": {
          "type": "row",
          "settings": {
            "criterion": "Asesoría profesional",
            "us": "Nutriólogos sin costo",
            "them": "Sin acompañamiento"
          }
        },
        "row-6": {
          "type": "row",
          "settings": {
            "criterion": "Aditivos y rellenos",
            "us": "Los mínimos necesarios",
            "them": "Colorantes y saborizantes"
          }
        }
      },
      "block_order": [
        "row-1",
        "row-2",
        "row-3",
        "row-4",
        "row-5",
        "row-6"
      ],
      "settings": {
        "eyebrow": "Comparativa",
        "heading": "Gia Evolv vs. otras marcas",
        "col_criterion": "Criterio",
        "col_us": "Gia Evolv",
        "col_them": "Otras marcas",
        "disclaimer": "Comparativa general frente a suplementos de venta masiva. No hace referencia a una marca específica.",
        "color_scheme": "scheme-6"
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "gia_comparison",
    "related-products"
  ]
}