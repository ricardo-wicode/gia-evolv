{%- comment -%}
  Iconos de línea del prototipo de diseño.
  Uso: {% render 'gia-icon', icon: 'flask', size: 23 %}
  Heredan el color con currentcolor, así que se tiñen desde el CSS.
{%- endcomment -%}

{%- assign s = size | default: 24 -%}
<svg
  width="{{ s }}" height="{{ s }}" viewBox="0 0 24 24"
  fill="none" stroke="currentcolor" stroke-width="1.7"
  stroke-linecap="round" stroke-linejoin="round"
  aria-hidden="true" focusable="false"
>
  {%- case icon -%}
    {%- when 'flask' -%}
      <path d="M10 2v7.5a2 2 0 0 1-.3 1L5 18a2 2 0 0 0 1.7 3h10.6a2 2 0 0 0 1.7-3l-4.7-7.5a2 2 0 0 1-.3-1V2"/>
      <path d="M8.5 2h7"/><path d="M7 16h10"/>
    {%- when 'microscope' -%}
      <path d="M9 11a3 3 0 1 0 6 0a3 3 0 0 0-6 0"/><path d="M12 3v2"/><path d="M12 17v4"/>
      <path d="m5 7 1.5 1.5"/><path d="M17.5 8.5 19 7"/><path d="M8 21h8"/>
      <path d="M6 14H4"/><path d="M20 14h-2"/>
    {%- when 'document' -%}
      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/>
      <path d="M15 2v5h5"/><path d="m9 15 2 2 4-4"/>
    {%- when 'chat' -%}
      <path d="M14 9a2 2 0 0 1-2 2H6l-4 3V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2Z"/>
      <path d="M18 9h2a2 2 0 0 1 2 2v9l-4-3h-6a2 2 0 0 1-2-2v-1"/>
    {%- when 'leaf' -%}
      <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
      <path d="M2 21c0-3 1.85-5.36 5.08-6"/>
    {%- when 'shield' -%}
      <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1Z"/>
      <path d="m9 12 2 2 4-4"/>
    {%- when 'truck' -%}
      <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/>
      <path d="M15 18H9"/>
      <path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.62l-3.48-4.35A1 1 0 0 0 17.52 8H14"/>
      <circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/>
    {%- else -%}
      <circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/>
  {%- endcase -%}
</svg>
