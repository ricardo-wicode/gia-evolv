{{ 'section-gia-video-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gia-rail.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gia-video-facade.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign items = section.blocks | where: 'type', 'video'
-%}

{%- if items.size > 0 -%}
  <section class="gia-vt color-{{ section.settings.color_scheme }}">
    <div class="gia-vt__inner">
      {% render 'gia-section-heading',
        eyebrow: section.settings.eyebrow,
        title: section.settings.heading,
        description: section.settings.description,
        align: 'center' %}

      <div class="gia-vt__rail-wrap" data-gia-rail-wrap>
        <button type="button" class="gia-rail-arrow gia-rail-arrow--prev"
                aria-label="Anterior" data-gia-rail-prev hidden>
          {% render 'gia-icon', icon: 'chevron-down', size: 18 %}
        </button>
        <button type="button" class="gia-rail-arrow gia-rail-arrow--next"
                aria-label="Siguiente" data-gia-rail-next hidden>
          {% render 'gia-icon', icon: 'chevron-down', size: 18 %}
        </button>

        <ul class="gia-vt__rail" data-gia-rail tabindex="0" role="list"
            aria-label="{{ section.settings.heading | escape }}">
          {%- for block in items -%}
            {%- liquid
              assign v = block.settings.video
              assign ext = block.settings.external_url
              assign poster = block.settings.poster
              if poster == blank and v != blank
                assign poster = v.preview_image
              endif
            -%}
            <li class="gia-vt__item" {{ block.shopify_attributes }}>
              {%- comment -%}
                Fachada: sólo se carga el póster. El vídeo —o el iframe de
                YouTube/Vimeo— no se pide hasta que alguien pulsa play, así
                la portada no arrastra megabytes de vídeo ni scripts de
                terceros que además rastrean sin consentimiento.
              {%- endcomment -%}
              {%- comment -%}
                Una sola superficie: la etiqueta, el play y el texto van
                superpuestos sobre el póster, como en el diseño. No se
                apilan en bloques, que partía la tarjeta en dos.
              {%- endcomment -%}
              <article class="gia-vt__card"
                       data-gia-video-facade
                       {% if v != blank %}data-video-id="{{ v.id }}"{% endif %}
                       {% if ext != blank %}data-external="{{ ext | escape }}"{% endif %}>

                {%- if poster != blank -%}
                  {{
                    poster
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      widths: '300, 450, 600, 800',
                      sizes: '(min-width: 990px) 25vw, 70vw',
                      class: 'gia-vt__poster',
                      alt: block.settings.quote | default: section.settings.heading
                  }}
                {%- endif -%}

                {%- comment -%} Degrada el pie para que el texto se lea sobre cualquier fotograma. {%- endcomment -%}
                <span class="gia-vt__scrim" aria-hidden="true"></span>

                <div class="gia-vt__head">
                  {%- if block.settings.label != blank -%}
                    <span class="gia-vt__label">{{ block.settings.label }}</span>
                  {%- endif -%}
                  {%- if block.settings.duration != blank -%}
                    <span class="gia-vt__duration">{{ block.settings.duration }}</span>
                  {%- endif -%}
                </div>

                {%- if v != blank or ext != blank -%}
                  <button type="button" class="gia-vt__play"
                          aria-label="Reproducir el testimonio de {{ block.settings.author | default: 'un cliente' | escape }}">
                    <span class="gia-vt__play-icon" aria-hidden="true"></span>
                  </button>
                  {%- if v != blank -%}
                    <template data-gia-video-source>
                      {{ v | video_tag: controls: true, playsinline: true, preload: 'none', class: 'gia-vt__video' }}
                    </template>
                  {%- endif -%}
                {%- else -%}
                  {%- comment -%}
                    Sin vídeo el play se dibuja igual, pero como <span>
                    decorativo: se ve, no se puede pulsar ni enfocar.
                  {%- endcomment -%}
                  <span class="gia-vt__play gia-vt__play--empty" aria-hidden="true">
                    <span class="gia-vt__play-icon"></span>
                  </span>
                {%- endif -%}

                <div class="gia-vt__body">
                  {%- if block.settings.rating > 0 -%}
                    <span class="gia-vt__stars" role="img"
                          aria-label="{{ block.settings.rating }} de 5 estrellas">
                      <span class="rating-star" aria-hidden="true"
                            style="--rating: {{ block.settings.rating }}; --rating-max: 5; --rating-decimal: 0;"></span>
                    </span>
                  {%- endif -%}
                  {%- if block.settings.quote != blank -%}
                    <p class="gia-vt__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
                  {%- endif -%}
                  {%- if block.settings.author != blank -%}
                    <p class="gia-vt__author">
                      {{ block.settings.author }}{% if block.settings.city != blank %} &middot; {{ block.settings.city }}{% endif %}
                    </p>
                  {%- endif -%}
                </div>
              </article>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Gia · Video testimonios",
  "tag": "section",
  "class": "gia-vt-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Testimonios en video" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Lo que dicen quienes ya evolucionaron" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Historias de 30 a 60 segundos, grabadas en vertical por nuestra propia comunidad."
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Testimonio",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "Subido a Shopify. Se carga sólo al pulsar play." },
        {
          "type": "text",
          "id": "external_url",
          "label": "O enlace de YouTube / Vimeo",
          "info": "Se usa si no hay video subido. Tampoco carga nada hasta pulsar play."
        },
        { "type": "image_picker", "id": "poster", "label": "Portada", "info": "Si se deja vacía, usa el fotograma del video." },
        { "type": "text", "id": "label", "label": "Etiqueta superior", "info": "Por ejemplo, el producto del que habla." },
        { "type": "text", "id": "duration", "label": "Duración", "default": "0:42" },
        { "type": "range", "id": "rating", "label": "Estrellas", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "quote", "label": "Frase" },
        { "type": "text", "id": "author", "label": "Nombre" },
        { "type": "text", "id": "city", "label": "Ciudad" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gia · Video testimonios",
      "blocks": [{ "type": "video" }, { "type": "video" }, { "type": "video" }, { "type": "video" }]
    }
  ]
}
{% endschema %}
