{{ 'section-gia-cta.css' | asset_url | stylesheet_tag }}

<section class="gia-cta color-{{ section.settings.color_scheme }}">
  <div class="gia-cta__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="gia-cta__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="gia-cta__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="gia-cta__text">{{ section.settings.text }}</p>
    {%- endif -%}

    {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
      <div class="gia-cta__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}"
             class="gia-cta__button gia-cta__button--primary">
            {{ section.settings.primary_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_link | default: routes.root_url }}"
             class="gia-cta__button gia-cta__button--ghost">
            {{ section.settings.secondary_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Gia · Llamada a la acción",
  "tag": "section",
  "class": "gia-cta-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Siguiente paso" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "¿Listo para evolucionar tu bienestar?" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Te ayudamos a elegir la fórmula según tu objetivo, sin costo y sin compromiso." },
    { "type": "text", "id": "primary_label", "label": "Botón principal", "default": "Explorar productos" },
    { "type": "url", "id": "primary_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "secondary_label", "label": "Botón secundario", "default": "Hablemos" },
    { "type": "url", "id": "secondary_link", "label": "Enlace del botón secundario" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-4" }
  ],
  "presets": [{ "name": "Gia · Llamada a la acción" }]
}
{% endschema %}
