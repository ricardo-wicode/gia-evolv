{{ 'section-gia-columns.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign items = section.blocks | where: 'type', 'column'
-%}

{%- if items.size > 0 -%}
  <section class="gia-cols color-{{ section.settings.color_scheme }}">
    <div class="gia-cols__inner">
      {% render 'gia-section-heading',
        eyebrow: section.settings.eyebrow,
        title: section.settings.heading,
        description: section.settings.description,
        align: section.settings.align %}

      <ul class="gia-cols__grid" role="list" style="--gia-cols: {{ items.size }};">
        {%- for block in items -%}
          <li class="gia-cols__item" {{ block.shopify_attributes }}>
            <article class="gia-cols__card">
              {%- if block.settings.eyebrow != blank -%}
                <span class="gia-cols__eyebrow">{{ block.settings.eyebrow }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="gia-cols__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="gia-cols__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </article>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Gia · Columnas",
  "tag": "section",
  "class": "gia-cols-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Titular" },
    { "type": "textarea", "id": "description", "label": "Descripción" },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación del encabezado",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "left"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-5" }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Columna",
      "settings": [
        { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Misión" },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Texto" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gia · Columnas",
      "blocks": [
        { "type": "column", "settings": { "eyebrow": "Misión" } },
        { "type": "column", "settings": { "eyebrow": "Visión" } },
        { "type": "column", "settings": { "eyebrow": "Valores" } }
      ]
    }
  ]
}
{% endschema %}
