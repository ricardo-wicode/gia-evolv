{{ 'section-gia-editorial.css' | asset_url | stylesheet_tag }}

<section class="gia-editorial gia-editorial--{{ section.settings.media_position }} color-{{ section.settings.color_scheme }}">
  <div class="gia-editorial__inner">
    <div class="gia-editorial__text">
      {%- if section.settings.eyebrow != blank -%}
        <span class="gia-editorial__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        {%- if section.settings.heading_tag == 'h1' -%}
          <h1 class="gia-editorial__heading">{{ section.settings.heading }}</h1>
        {%- else -%}
          <h2 class="gia-editorial__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'paragraph' and block.settings.text != blank -%}
          <p class="gia-editorial__paragraph" {{ block.shopify_attributes }}>{{ block.settings.text }}</p>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="gia-editorial__actions">
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="gia-editorial__cta">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {%- endif -%}
    </div>

    <div class="gia-editorial__media" style="--gia-editorial-ratio: {{ section.settings.ratio }};">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(min-width: 990px) 50vw, 100vw',
            alt: section.settings.image.alt | default: section.settings.heading
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gia · Editorial",
  "tag": "section",
  "class": "gia-editorial-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Nosotros" },
    { "type": "text", "id": "heading", "label": "Titular" },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Nivel del titular",
      "options": [
        { "value": "h1", "label": "h1 — encabezado de la página" },
        { "value": "h2", "label": "h2 — sección dentro de la página" }
      ],
      "default": "h2",
      "info": "Sólo una sección por página debería usar h1."
    },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    {
      "type": "select",
      "id": "media_position",
      "label": "Posición de la imagen",
      "options": [
        { "value": "right", "label": "Derecha" },
        { "value": "left", "label": "Izquierda" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "4 / 3", "label": "Horizontal (4:3)" },
        { "value": "1 / 1", "label": "Cuadrada" },
        { "value": "4 / 5", "label": "Vertical (4:5)" }
      ],
      "default": "4 / 3"
    },
    { "type": "text", "id": "cta_label", "label": "Texto del botón" },
    { "type": "url", "id": "cta_link", "label": "Enlace del botón" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "paragraph",
      "name": "Párrafo",
      "settings": [{ "type": "textarea", "id": "text", "label": "Texto" }]
    }
  ],
  "presets": [
    { "name": "Gia · Editorial", "blocks": [{ "type": "paragraph" }, { "type": "paragraph" }] }
  ]
}
{% endschema %}
