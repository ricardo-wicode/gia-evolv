{{ 'section-gia-hero.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Hero a sangre: la imagen abarca todo el bloque y el texto va encima.
  Dos variantes de imagen — horizontal en escritorio, vertical en móvil —
  con las del banner como respaldo si no se elige otra en el editor.
  El texto se coloca sobre la zona despejada de cada imagen: a la
  izquierda en escritorio, arriba en móvil.
{%- endcomment -%}

<section class="gia-hero color-{{ section.settings.color_scheme }}{% if section.settings.overlay %} gia-hero--scrim{% endif %}">
  <div class="gia-hero__bg">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2200
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '1000, 1400, 1800, 2200',
          class: 'gia-hero__img gia-hero__img--desktop',
          alt: section.settings.image.alt | default: shop.name
      }}
    {%- else -%}
      <img src="{{ 'banner-gia.jpg' | asset_url }}"
           class="gia-hero__img gia-hero__img--desktop"
           width="2200" height="1228" loading="eager" fetchpriority="high"
           alt="{{ section.settings.image_fallback_alt | escape }}">
    {%- endif -%}

    {%- if section.settings.image_mobile != blank -%}
      {{
        section.settings.image_mobile
        | image_url: width: 1200
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '600, 900, 1200',
          class: 'gia-hero__img gia-hero__img--mobile',
          alt: section.settings.image_mobile.alt | default: shop.name
      }}
    {%- else -%}
      <img src="{{ 'banner-gia-mobile.jpg' | asset_url }}"
           class="gia-hero__img gia-hero__img--mobile"
           width="669" height="1200" loading="eager" fetchpriority="high"
           alt="{{ section.settings.image_fallback_alt | escape }}">
    {%- endif -%}
  </div>

  <div class="gia-hero__overlay">
    <div class="gia-hero__text">
      {%- if section.settings.kicker != blank -%}
        <p class="gia-hero__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="gia-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="gia-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}

      {%- if section.settings.cta_label != blank -%}
        <div class="gia-hero__actions">
          <a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
             class="gia-hero__cta">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gia · Hero",
  "tag": "section",
  "class": "gia-hero-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titular",
      "default": "Nutrición que evoluciona con tu cuerpo"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Descripción",
      "default": "Suplementación de grado clínico con dosis reales y etiqueta completa, formulada junto con nutriólogos y bioquímicos."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Remate",
      "info": "Frase corta en negrita sobre el titular.",
      "default": "Sin relleno, sin promesas vacías."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texto del botón",
      "default": "Ver catálogo"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Enlace del botón",
      "info": "Si se deja vacío, apunta a todos los productos."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen (escritorio)",
      "info": "Horizontal. Si se deja vacía se usa el banner incluido."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Imagen (móvil)",
      "info": "Vertical. Si se deja vacía se usa el banner móvil incluido."
    },
    {
      "type": "text",
      "id": "image_fallback_alt",
      "label": "Texto alternativo de la imagen",
      "default": "Línea de suplementos Gia Evolv sobre una superficie"
    },
    {
      "type": "checkbox",
      "id": "overlay",
      "label": "Velo sobre la imagen",
      "info": "Aclara la zona del texto para mejorar la lectura.",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    }
  ],
  "presets": [{ "name": "Gia · Hero" }]
}
{% endschema %}
