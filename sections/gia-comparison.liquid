{{ 'section-gia-comparison.css' | asset_url | stylesheet_tag }}

{%- liquid
  # En una ficha de producto manda el metacampo: tres listas de texto de
  # una línea (criterio, columna Gia y columna de comparación) que se
  # emparejan por posición — el 1.er texto de cada lista es la 1.ª fila, y
  # así sucesivamente. Si no hay criterios, la sección no se muestra.
  # Fuera de producto (uso general del tema) se usan los bloques.
  assign use_mf = false
  assign rows_count = 0
  assign rows = ''

  if product != blank
    assign c_list = product.metafields.custom.comparison_criteria.value
    assign g_list = product.metafields.custom.comparison_gia.value
    assign o_list = product.metafields.custom.comparison_others.value
    if c_list != blank and c_list.size > 0
      assign use_mf = true
      assign rows_count = c_list.size
    endif
  else
    assign rows = section.blocks | where: 'type', 'row'
    assign rows_count = rows.size
  endif
-%}

{%- if rows_count > 0 -%}
<section
  id="gia-comparison-{{ section.id }}"
  class="gia-comparison color-{{ section.settings.color_scheme }}"
  style="--gia-ct-bg: {{ section.settings.table_bg | default: '#FFFFFF' }}; --gia-ct-text: {{ section.settings.table_text | default: '#141414' }}; --gia-ct-gia: {{ section.settings.gia_color | default: '#009389' }}; --gia-ct-other: {{ section.settings.other_color | default: '#5B6672' }};"
>
  <div class="gia-comparison__inner">
    <div class="gia-comparison__header">
      {%- if section.settings.eyebrow != blank -%}
        <span class="gia-comparison__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="gia-comparison__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
    </div>

      {%- comment -%}
        Tabla de datos real, no un grid de divs: la relación entre el
        criterio y cada columna tiene que sobrevivir a un lector de
        pantalla. El scroll horizontal vive en el contenedor para que la
        página nunca se desborde.
      {%- endcomment -%}
      <div class="gia-comparison__viewport">
        <div class="gia-comparison__scroll" tabindex="0" role="region" aria-labelledby="gia-comparison-caption-{{ section.id }}">
        <table class="gia-comparison__table">
          <caption id="gia-comparison-caption-{{ section.id }}" class="visually-hidden">
            {{ section.settings.heading | default: 'Comparativa' }}
          </caption>
          <thead>
            <tr>
              <th scope="col" class="gia-comparison__th gia-comparison__th--criterion">
                {{ section.settings.col_criterion }}
              </th>
              <th scope="col" class="gia-comparison__th gia-comparison__th--us">
                {{ section.settings.col_us | default: shop.name }}
              </th>
              <th scope="col" class="gia-comparison__th gia-comparison__th--them">
                {{ section.settings.col_them }}
              </th>
            </tr>
          </thead>
          <tbody>
            {%- if use_mf -%}
              {%- for i in (1..rows_count) -%}
                {%- liquid
                  assign idx = forloop.index0
                  assign r_criterion = c_list[idx]
                  assign r_us = g_list[idx]
                  assign r_them = o_list[idx]
                -%}
                <tr>
                  <th scope="row" class="gia-comparison__criterion">{{ r_criterion }}</th>
                  <td class="gia-comparison__us">{{ r_us }}</td>
                  <td class="gia-comparison__them">{{ r_them }}</td>
                </tr>
              {%- endfor -%}
            {%- else -%}
              {%- for block in rows -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row" class="gia-comparison__criterion">{{ block.settings.criterion }}</th>
                  <td class="gia-comparison__us">{{ block.settings.us }}</td>
                  <td class="gia-comparison__them">{{ block.settings.them }}</td>
                </tr>
              {%- endfor -%}
            {%- endif -%}
          </tbody>
        </table>
        </div>
      </div>
      <p class="gia-comparison__hint" aria-hidden="true">Desliza para ver la comparación completa &rarr;</p>

    {%- if section.settings.disclaimer != blank -%}
      <p class="gia-comparison__disclaimer">{{ section.settings.disclaimer }}</p>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('gia-comparison-{{ section.id }}');
    if (!root) return;
    var scroll = root.querySelector('.gia-comparison__scroll');
    if (!scroll) return;

    // Hay degradado/pista solo si queda contenido por deslizar a la
    // derecha. Al llegar al final (o si la tabla cabe sin scroll) se quita.
    var update = function () {
      var more = scroll.scrollWidth - scroll.clientWidth - scroll.scrollLeft > 1;
      root.classList.toggle('gia-comparison--scrollable', more);
    };

    scroll.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
    // Recalcula cuando acaben de cargar fuentes/imagen y se asiente el ancho.
    window.addEventListener('load', update);
    setTimeout(update, 300);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Gia · Comparativa",
  "tag": "section",
  "class": "gia-comparison-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Comparativa" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Gia Evolv vs. otras marcas" },
    { "type": "header", "content": "Columnas" },
    { "type": "text", "id": "col_criterion", "label": "Columna 1", "default": "Criterio" },
    { "type": "text", "id": "col_us", "label": "Columna 2", "default": "Gia Evolv" },
    { "type": "text", "id": "col_them", "label": "Columna 3", "default": "Otras marcas" },
    { "type": "header", "content": "Pie" },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Aviso legal",
      "info": "Una comparativa que señale a una marca concreta puede ser publicidad comparativa desleal. Conviene mantenerla genérica.",
      "default": "Comparativa general frente a suplementos de venta masiva. No hace referencia a una marca específica."
    },
    { "type": "header", "content": "Apariencia" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color (fondo de la sección)", "default": "scheme-6" },
    { "type": "header", "content": "Colores de la tabla" },
    {
      "type": "color",
      "id": "table_bg",
      "label": "Fondo de la tabla",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "table_text",
      "label": "Texto de la tabla",
      "info": "Tono oscuro si el fondo es claro, o claro si el fondo es oscuro.",
      "default": "#141414"
    },
    {
      "type": "color",
      "id": "gia_color",
      "label": "Color columna Gia Evolv",
      "info": "El encabezado va en este color sólido y las celdas en el mismo color con transparencia.",
      "default": "#009389"
    },
    {
      "type": "color",
      "id": "other_color",
      "label": "Color otras columnas",
      "info": "Aplica a la columna de criterio y a la de comparación: encabezado sólido y celdas con transparencia.",
      "default": "#5B6672"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Fila",
      "settings": [
        { "type": "text", "id": "criterion", "label": "Criterio" },
        { "type": "text", "id": "us", "label": "Nuestra columna" },
        { "type": "text", "id": "them", "label": "Columna de comparación" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gia · Comparativa",
      "blocks": [
        { "type": "row", "settings": { "criterion": "Dosis por porción", "us": "Dosis completa del estudio", "them": "Fracción repartida" } },
        { "type": "row", "settings": { "criterion": "Transparencia de etiqueta", "us": "Cada miligramo publicado", "them": "Mezclas propietarias" } },
        { "type": "row", "settings": { "criterion": "Forma del ingrediente", "us": "Alta biodisponibilidad", "them": "La más económica" } },
        { "type": "row", "settings": { "criterion": "Certificado por lote", "us": "Sí, en cada lote", "them": "Rara vez disponible" } },
        { "type": "row", "settings": { "criterion": "Asesoría profesional", "us": "Nutriólogos sin costo", "them": "Sin acompañamiento" } },
        { "type": "row", "settings": { "criterion": "Aditivos y rellenos", "us": "Los mínimos necesarios", "them": "Colorantes y saborizantes" } }
      ]
    }
  ]
}
{% endschema %}
