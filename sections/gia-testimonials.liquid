{{ 'section-gia-testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gia-rail.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign items = section.blocks | where: 'type', 'quote'
-%}

{%- if items.size > 0 -%}
  <section class="gia-tm color-{{ section.settings.color_scheme }}">
    <div class="gia-tm__inner">
      {% render 'gia-section-heading',
        eyebrow: section.settings.eyebrow,
        title: section.settings.heading,
        align: section.settings.align %}

      <div class="gia-tm__rail-wrap" data-gia-rail-wrap>
        <button type="button" class="gia-rail-arrow gia-rail-arrow--prev"
                aria-label="Anterior" data-gia-rail-prev hidden>
          {% render 'gia-icon', icon: 'chevron-down', size: 18 %}
        </button>
        <button type="button" class="gia-rail-arrow gia-rail-arrow--next"
                aria-label="Siguiente" data-gia-rail-next hidden>
          {% render 'gia-icon', icon: 'chevron-down', size: 18 %}
        </button>

        <ul class="gia-tm__rail" data-gia-rail tabindex="0" role="list"
            aria-label="{{ section.settings.heading | escape }}">
          {%- for block in items -%}
            <li class="gia-tm__item" {{ block.shopify_attributes }}>
              <figure class="gia-tm__card">
                {%- if block.settings.rating > 0 -%}
                  <span class="gia-tm__stars" role="img"
                        aria-label="{{ block.settings.rating }} de 5 estrellas">
                    <span class="rating-star" aria-hidden="true"
                          style="--rating: {{ block.settings.rating }}; --rating-max: 5; --rating-decimal: 0;"></span>
                  </span>
                {%- endif -%}
                {%- if block.settings.quote != blank -%}
                  <blockquote class="gia-tm__quote">&ldquo;{{ block.settings.quote }}&rdquo;</blockquote>
                {%- endif -%}
                {%- if block.settings.author != blank -%}
                  <figcaption class="gia-tm__author">
                    {{ block.settings.author }}{% if block.settings.meta != blank %} &mdash; {{ block.settings.meta }}{% endif %}
                  </figcaption>
                {%- endif -%}
              </figure>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Gia · Testimonios",
  "tag": "section",
  "class": "gia-tm-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo" },
    { "type": "text", "id": "heading", "label": "Titular" },
    {
      "type": "select",
      "id": "align",
      "label": "Alineación del encabezado",
      "options": [
        { "value": "left", "label": "Izquierda" },
        { "value": "center", "label": "Centro" }
      ],
      "default": "center"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-5" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonio",
      "settings": [
        { "type": "range", "id": "rating", "label": "Estrellas", "min": 0, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Testimonio" },
        { "type": "text", "id": "author", "label": "Nombre" },
        { "type": "text", "id": "meta", "label": "Detalle", "info": "Por ejemplo: clienta desde 2023." }
      ]
    }
  ],
  "presets": [
    { "name": "Gia · Testimonios", "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }] }
  ]
}
{% endschema %}
