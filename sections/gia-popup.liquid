{{ 'section-gia-popup.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Popup de suscripción con descuento de bienvenida.

  Comportamiento clásico: aparece a los N segundos de entrar, se cierra
  con la X, el enlace de "no gracias", Escape o clic fuera, y una vez
  cerrado no vuelve a salir durante los días configurados (localStorage).
  Si el visitante se suscribe, no vuelve a aparecer nunca.

  El formulario es el de clientes de Shopify (mismo patrón que el
  boletín): al enviarse la página recarga y aquí se muestra el estado de
  éxito o el error reabriendo el popup de inmediato.
{%- endcomment -%}

{%- if section.settings.enable -%}
<div
  class="gia-popup"
  data-gia-popup
  data-delay="{{ section.settings.delay }}"
  data-days="{{ section.settings.frequency }}"
  hidden
>
  <div class="gia-popup__backdrop" data-gia-popup-close></div>

  <div class="gia-popup__card" role="dialog" aria-modal="true" aria-labelledby="GiaPopupHeading-{{ section.id }}">
    <button type="button" class="gia-popup__x" data-gia-popup-close aria-label="Cerrar">
      {% render 'gia-icon', icon: 'x', size: 18 %}
    </button>

    <div class="gia-popup__media" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 900
          | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 750px) 380px, 100vw', alt: ''
        }}
      {%- else -%}
        <img src="{{ 'popup-gia.jpg' | asset_url }}" width="735" height="940" loading="lazy" alt="">
      {%- endif -%}
    </div>

    <div class="gia-popup__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="gia-popup__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <h2 class="gia-popup__heading" id="GiaPopupHeading-{{ section.id }}">{{ section.settings.heading }}</h2>

      {%- if section.settings.body != blank -%}
        <div class="gia-popup__body">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- form 'customer', class: 'gia-popup__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter,popup">

        {%- if form.posted_successfully? -%}
          <span data-gia-popup-posted hidden></span>
          <p class="gia-popup__ok" role="status">{{ section.settings.success }}</p>
        {%- else -%}
          {%- if form.errors -%}
            <span data-gia-popup-error hidden></span>
          {%- endif -%}

          <label class="gia-popup__label" for="GiaPopupEmail-{{ section.id }}">
            {{ section.settings.email_label }}
          </label>
          <input
            id="GiaPopupEmail-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="gia-popup__input"
            placeholder="{{ section.settings.placeholder | escape }}"
            autocomplete="email"
            required
            {% if form.errors %}aria-invalid="true" aria-describedby="GiaPopupError-{{ section.id }}"{% endif %}
          >

          {%- if form.errors -%}
            <p class="gia-popup__error" id="GiaPopupError-{{ section.id }}" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}

          <button type="submit" class="gia-popup__submit">{{ section.settings.button_label }}</button>
        {%- endif -%}
      {%- endform -%}

      {%- if section.settings.dismiss_label != blank -%}
        <button type="button" class="gia-popup__no" data-gia-popup-close>
          {{ section.settings.dismiss_label }}
        </button>
      {%- endif -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var pop = document.querySelector('[data-gia-popup]');
    if (!pop) return;

    var KEY = 'gia:popup';
    var days = parseInt(pop.dataset.days || '30', 10);
    var delay = parseFloat(pop.dataset.delay || '5') * 1000;

    var read = function () {
      try { return JSON.parse(localStorage.getItem(KEY)) || null; } catch (e) { return null; }
    };
    var write = function (v) {
      try { localStorage.setItem(KEY, JSON.stringify(v)); } catch (e) {}
    };

    var opener = null;
    var open = function () {
      pop.hidden = false;
      document.documentElement.classList.add('gia-popup-open');
      opener = document.activeElement;
      var x = pop.querySelector('.gia-popup__x');
      if (x) x.focus();
    };
    var close = function (remember) {
      pop.hidden = true;
      document.documentElement.classList.remove('gia-popup-open');
      if (remember !== false) write({ t: Date.now() });
      if (opener && opener.focus) opener.focus();
    };

    pop.querySelectorAll('[data-gia-popup-close]').forEach(function (el) {
      el.addEventListener('click', function () { close(); });
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !pop.hidden) close();
    });

    // Tras enviar el formulario la página recarga: si hubo alta o error,
    // el popup se reabre al instante para mostrar el resultado.
    if (pop.querySelector('[data-gia-popup-posted]')) {
      write({ t: Date.now(), done: true });
      open();
      return;
    }
    if (pop.querySelector('[data-gia-popup-error]')) {
      open();
      return;
    }

    var st = read();
    if (st && (st.done || Date.now() - st.t < days * 86400000)) return;

    // En el editor de temas se abre al seleccionar la sección, no por tiempo.
    if (window.Shopify && Shopify.designMode) {
      document.addEventListener('shopify:section:select', function (e) {
        if (e.target.contains(pop)) open();
      });
      document.addEventListener('shopify:section:deselect', function (e) {
        if (e.target.contains(pop)) close(false);
      });
      return;
    }

    setTimeout(open, delay);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Gia · Popup",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Activar popup", "default": true },
    {
      "type": "range",
      "id": "delay",
      "label": "Segundos para aparecer",
      "min": 0, "max": 20, "step": 1, "default": 5, "unit": "s"
    },
    {
      "type": "range",
      "id": "frequency",
      "label": "Días sin volver a salir",
      "info": "Tras cerrarse sin suscripción. Quien se suscribe no lo vuelve a ver.",
      "min": 1, "max": 90, "step": 1, "default": 30, "unit": "d"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen",
      "info": "Vertical. Si se deja vacía se usa la foto incluida."
    },
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Bienestar que se nota" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Tu bienestar merece un empujón extra" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Texto",
      "default": "<p>Regístrate y obtén <strong>10% de descuento</strong> en tu primer pedido. Además, recibe acceso anticipado a lanzamientos y promociones exclusivas.</p>"
    },
    { "type": "text", "id": "email_label", "label": "Etiqueta del campo", "default": "Correo" },
    { "type": "text", "id": "placeholder", "label": "Marcador del campo", "default": "ejemplo@mail.com" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Activar mi descuento" },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "Enlace para rechazar",
      "default": "No, prefiero pagar el precio completo"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Mensaje de éxito",
      "default": "¡Listo! Revisa tu bandeja: tu descuento va en camino."
    }
  ],
  "presets": [{ "name": "Gia · Popup" }]
}
{% endschema %}
