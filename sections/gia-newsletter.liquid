{{ 'section-gia-newsletter.css' | asset_url | stylesheet_tag }}

<section class="gia-nl-section">
  <div class="gia-nl__outer">
    <div class="gia-nl color-{{ section.settings.color_scheme }}">
      <div class="gia-nl__text">
        {%- if section.settings.eyebrow != blank -%}
          <span class="gia-nl__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="gia-nl__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="gia-nl__note">{{ section.settings.text }}</p>
        {%- endif -%}
      </div>

      <div class="gia-nl__form-col">
        {%- form 'customer', class: 'gia-nl__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="gia-nl-{{ section.id }}">
            {{ section.settings.placeholder }}
          </label>
          <input
            id="gia-nl-{{ section.id }}"
            type="email"
            name="contact[email]"
            class="gia-nl__input"
            placeholder="{{ section.settings.placeholder | escape }}"
            autocomplete="email"
            required
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
          <button type="submit" class="gia-nl__submit">{{ section.settings.button_label }}</button>

          {%- comment -%} El objeto `form` sólo existe dentro del bloque. {%- endcomment -%}
          {%- if form.posted_successfully? -%}
            <p class="gia-nl__ok" role="status">{{ section.settings.success }}</p>
          {%- elsif form.errors -%}
            <p class="gia-nl__error" role="alert">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gia · Boletín",
  "tag": "section",
  "class": "gia-nl-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Newsletter" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Recibe tips de bienestar y acceso anticipado" },
    { "type": "text", "id": "text", "label": "Nota", "default": "Un correo al mes, sin spam." },
    { "type": "text", "id": "placeholder", "label": "Marcador del campo", "default": "tu@correo.com" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Suscribirme" },
    { "type": "text", "id": "success", "label": "Mensaje de éxito", "default": "Listo, te escribiremos pronto." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-4" }
  ],
  "presets": [{ "name": "Gia · Boletín" }]
}
{% endschema %}
