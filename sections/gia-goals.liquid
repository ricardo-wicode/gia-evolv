{{ 'section-gia-goals.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign tiles = section.blocks | where: 'type', 'goal'
-%}

{%- if tiles.size > 0 -%}
  <section class="gia-goals color-{{ section.settings.color_scheme }}">
    <div class="gia-goals__inner">
      {% render 'gia-section-heading',
        eyebrow: section.settings.eyebrow,
        title: section.settings.heading,
        description: section.settings.description %}

      <div class="gia-goals__rail-wrap">
        {%- comment -%}
          Las flechas nacen ocultas y el script las descubre: sin JS no
          harían nada, y un botón muerto es peor que ninguno. El carril
          se puede recorrer igualmente con dedo, rueda o teclado.
        {%- endcomment -%}
        <button type="button" class="gia-goals__arrow gia-goals__arrow--prev"
                aria-label="Anterior" data-gia-rail-prev hidden>
          {% render 'gia-icon', icon: 'chevron-down', size: 18 %}
        </button>
        <button type="button" class="gia-goals__arrow gia-goals__arrow--next"
                aria-label="Siguiente" data-gia-rail-next hidden>
          {% render 'gia-icon', icon: 'chevron-down', size: 18 %}
        </button>

        <ul class="gia-goals__rail" data-gia-rail tabindex="0"
            aria-label="{{ section.settings.heading | escape }}" role="list">
          {%- for block in tiles -%}
            {%- liquid
              assign col = block.settings.collection
              assign img = block.settings.image
              if img == blank and col != blank
                assign img = col.image | default: col.products.first.featured_image
              endif
              assign label = block.settings.label | default: col.title
              assign url = block.settings.link | default: col.url
            -%}
            <li class="gia-goals__item" {{ block.shopify_attributes }}>
              <a class="gia-goals__tile" href="{{ url | default: routes.all_products_collection_url }}"
                 style="--gia-goal-ratio: {{ section.settings.ratio }};">
                <span class="gia-goals__media">
                  {%- if img != blank -%}
                    {{
                      img
                      | image_url: width: 600
                      | image_tag:
                        loading: 'lazy',
                        widths: '200, 300, 400, 600',
                        sizes: '(min-width: 990px) 240px, 60vw',
                        alt: img.alt | default: label
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </span>
                <span class="gia-goals__scrim"></span>
                <span class="gia-goals__text">
                  <span class="gia-goals__label">{{ label }}</span>
                  {%- if block.settings.caption != blank -%}
                    <span class="gia-goals__caption">{{ block.settings.caption }}</span>
                  {%- endif -%}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </section>
{%- endif -%}

<script>
  (function () {
    document.querySelectorAll('[data-gia-rail]').forEach(function (rail) {
      var wrap = rail.closest('.gia-goals__rail-wrap');
      var prev = wrap.querySelector('[data-gia-rail-prev]');
      var next = wrap.querySelector('[data-gia-rail-next]');
      if (!prev || !next) return;

      var step = function () {
        var item = rail.querySelector('.gia-goals__item');
        return item ? item.getBoundingClientRect().width + 16 : 240;
      };

      // Sólo se muestran si de verdad hay algo que recorrer.
      var sync = function () {
        var overflows = rail.scrollWidth - rail.clientWidth > 4;
        prev.hidden = !overflows;
        next.hidden = !overflows;
        if (!overflows) return;
        prev.disabled = rail.scrollLeft <= 2;
        next.disabled = rail.scrollLeft + rail.clientWidth >= rail.scrollWidth - 2;
      };

      prev.addEventListener('click', function () { rail.scrollBy({ left: -step(), behavior: 'smooth' }); });
      next.addEventListener('click', function () { rail.scrollBy({ left: step(), behavior: 'smooth' }); });
      rail.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    });
  })();
</script>

{% schema %}
{
  "name": "Gia · Por objetivo",
  "tag": "section",
  "class": "gia-goals-section",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Explora por objetivo" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "¿Qué buscas hoy?" },
    {
      "type": "textarea",
      "id": "description",
      "label": "Descripción",
      "default": "Cinco rutas para empezar. Cada fórmula está pensada para un objetivo concreto."
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Proporción de las tarjetas",
      "options": [
        { "value": "4 / 5", "label": "Vertical (4:5)" },
        { "value": "3 / 4", "label": "Vertical alta (3:4)" },
        { "value": "1 / 1", "label": "Cuadrada" }
      ],
      "default": "4 / 5"
    },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Objetivo",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección", "info": "De aquí salen el título, la imagen y el enlace si no se rellenan abajo." },
        { "type": "text", "id": "label", "label": "Título" },
        { "type": "text", "id": "caption", "label": "Pie" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "url", "id": "link", "label": "Enlace" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gia · Por objetivo",
      "blocks": [
        { "type": "goal", "settings": { "label": "Energía" } },
        { "type": "goal", "settings": { "label": "Sueño" } },
        { "type": "goal", "settings": { "label": "Movilidad" } },
        { "type": "goal", "settings": { "label": "Digestión" } },
        { "type": "goal", "settings": { "label": "Defensas" } }
      ]
    }
  ]
}
{% endschema %}
