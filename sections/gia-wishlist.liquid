{{ 'section-gia-wishlist.css' | asset_url | stylesheet_tag }}

<section class="gia-wishlist color-{{ section.settings.color_scheme }}">
  <div class="gia-wishlist__inner">
    <div class="gia-wishlist__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="gia-wishlist__eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="gia-wishlist__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="gia-wishlist__text">{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      La lista se pinta en el cliente: vive en localStorage, así que el
      servidor no puede conocerla. El estado vacío es el que se sirve por
      defecto, para que quien llegue sin JS vea un mensaje con salida al
      catálogo en lugar de una página en blanco.
    {%- endcomment -%}
    <gia-wishlist-list
      data-currency="{{ cart.currency.iso_code }}"
      data-locale="{{ request.locale.iso_code | default: 'es-MX' }}"
    >
      <p class="gia-wishlist__loading" data-gia-wishlist-loading hidden>
        {{ section.settings.loading_text }}
      </p>

      <ul class="gia-wishlist__grid" data-gia-wishlist-grid role="list"></ul>

      <div class="gia-wishlist__empty" data-gia-wishlist-empty>
        <p>{{ section.settings.empty_text }}</p>
        <a class="gia-wishlist__cta" href="{{ section.settings.empty_link | default: routes.all_products_collection_url }}">
          {{ section.settings.empty_label }}
        </a>
      </div>
    </gia-wishlist-list>
  </div>
</section>

{% schema %}
{
  "name": "Gia · Favoritos",
  "tag": "section",
  "class": "gia-wishlist-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Tu selección" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "Favoritos" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Texto",
      "default": "Se guardan en este navegador. Si cambias de dispositivo o borras los datos del sitio, tendrás que volver a elegirlos."
    },
    { "type": "text", "id": "loading_text", "label": "Texto de carga", "default": "Cargando tus favoritos…" },
    { "type": "textarea", "id": "empty_text", "label": "Texto cuando está vacío", "default": "Todavía no has guardado nada. Toca el corazón de cualquier producto para tenerlo aquí." },
    { "type": "text", "id": "empty_label", "label": "Botón cuando está vacío", "default": "Ver catálogo" },
    { "type": "url", "id": "empty_link", "label": "Enlace del botón" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Esquema de color", "default": "scheme-1" }
  ],
  "presets": [{ "name": "Gia · Favoritos" }]
}
{% endschema %}
